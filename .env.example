# Backend Configuration
BACKEND_PORT=8000
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql://voicebanker:voicebanker@localhost:5432/voicebanker
DB_USER=voicebanker
DB_PASSWORD=voicebanker
DB_HOST=localhost
DB_PORT=5432
DB_NAME=voicebanker

# API Configuration
API_SECRET_KEY=your-secret-key-change-this-in-production
API_ALGORITHM=HS256

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# Vosk ASR Configuration
VOSK_SAMPLE_RATE=16000
VOSK_MODEL_PATH=./backend/asr/models/vosk-model-small-en-us-0.15

# Rasa Configuration
RASA_MODEL_PATH=./backend/nlu/models/
RASA_SERVER_URL=http://localhost:5005

# TTS Configuration
TTS_MODEL_NAME=tts_models/en/ljspeech/glow-tts
TTS_DEVICE=cpu

# Voice Biometric Configuration
BIOMETRIC_THRESHOLD=0.75
LIVENESS_ENABLED=true

# Security
ENABLE_HTTPS=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Frontend
REACT_APP_API_URL=http://localhost:8000
REACT_APP_ENVIRONMENT=development
